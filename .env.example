# ── Production Environment Configuration ────────────────────────────────
# Copy this to .env for production deployment.
# Sensitive values (API keys, tokens) must be set in your CI/CD or secret
# manager — never commit real secrets.

# ── Telemetry (Langfuse) ─────────────────────────────────────────────────
ORA_LANGFUSE_ENABLED=true
ORA_LANGFUSE_EXPORT_MODE=batched
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_TRACING_ENVIRONMENT=production

# ── Search Providers (optional) ──────────────────────────────────────────
# Uncomment and set at least one key for web search in production.
# If all are unset, Ora falls back to DuckDuckGo HTML (no API key needed).
# ORA_SEARCH_PROVIDER=brave
# BRAVE_SEARCH_API_KEY=
# TAVILY_API_KEY=
# SERPAPI_API_KEY=
# KAGI_API_KEY=
