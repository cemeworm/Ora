# ── Production Environment Configuration ────────────────────────────────
# Copy this to .env for production deployment.
# Sensitive values (API keys, tokens) must be set in your CI/CD or secret
# manager — never commit real secrets.

# ── Telemetry (Langfuse) ─────────────────────────────────────────────────
ORA_LANGFUSE_ENABLED=true
ORA_LANGFUSE_EXPORT_MODE=batched
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_TRACING_ENVIRONMENT=production

# ── Search Providers (optional) ──────────────────────────────────────────
# Ora now defaults to the built-in AnySearch MCP server for web search.
# `ORA_SEARCH_PROVIDER` is only needed if you want to override the default.
# ANYSEARCH_API_KEY is optional; if unset, Ora uses anonymous AnySearch access.
# ANYSEARCH_API_KEY=
# ORA_SEARCH_PROVIDER=mcp
# TAVILY_API_KEY=
# BRAVE_SEARCH_API_KEY=
# SERPAPI_API_KEY=
# KAGI_API_KEY=
