{
  "name": "ora",
  "version": "0.3.5",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @ora/desktop dev",
    "dev:desktop": "./scripts/dev-desktop.sh",
    "dev:runtime": "pnpm --filter @ora/runtime dev",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "version:sync": "node scripts/version-sync.mjs --sync",
    "version:check": "node scripts/version-sync.mjs --check"
  },
  "pnpm": {
    "overrides": {
      "@tauri-apps/api": "2.10.1"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "typescript": "5.9.3"
  }
}
