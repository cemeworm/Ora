{
  "datasetId": "<import-causal-intervention-decision-dataset-first>",
  "profileId": "orchestration",
  "repetitions": 1,
  "concurrency": 2,
  "timeoutMs": 300000,
  "objective": {
    "kind": "outcome",
    "target": "run.output",
    "metrics": [
      "task_success_rate",
      "llm_judge_score",
      "intent_resolution",
      "clarification_precision",
      "effective_intervention",
      "over_action",
      "counterfactual_lift",
      "token_efficiency",
      "tool_efficiency",
      "agentic_cost_score",
      "visible_surface_shrinkage",
      "explore_first_score",
      "atomic_tool_hops",
      "first_locate_success",
      "shell_explore_restraint"
    ],
    "metadata": {
      "retrofitCausalDecisions": true
    }
  },
  "configs": [
    {
      "id": "causal-record-only",
      "label": "Causal Record Only (仅记录)",
      "runConfig": {
        "pattern": "orchestrator_subagent",
        "modeSelection": "auto",
        "causalInterventionLevel": "record_only",
        "metadata": {
          "evaluationBatch": "causal-three-way-comparison"
        }
      }
    },
    {
      "id": "causal-advisory",
      "label": "Causal Advisory (建议模式)",
      "runConfig": {
        "pattern": "orchestrator_subagent",
        "modeSelection": "auto",
        "causalInterventionLevel": "advisory",
        "metadata": {
          "evaluationBatch": "causal-three-way-comparison"
        }
      }
    },
    {
      "id": "causal-enforcing",
      "label": "Causal Enforcing (强制模式)",
      "runConfig": {
        "pattern": "orchestrator_subagent",
        "modeSelection": "auto",
        "causalInterventionLevel": "enforcing",
        "metadata": {
          "evaluationBatch": "causal-three-way-comparison"
        }
      }
    }
  ],
  "metadata": {
    "retrofitCausalDecisions": true,
    "description": "Three-way comparison spec for causal policy router at three intervention levels: record_only (baseline) vs advisory (gate approvals/stops) vs enforcing (block all non-safe tools). Each config runs the same 101 cases with different causalInterventionLevel. Use 'ora-runtime eval compare-configs' to generate the multi-way comparison report.",
    "evaluationFamily": "causal",
    "judgeRubricTemplate": "causal_outcome_v1",
    "judgePassThreshold": 0.7
  }
}
