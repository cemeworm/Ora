{
  "datasetId": "<import-causal-intervention-decision-dataset-first>",
  "profileId": "orchestration",
  "repetitions": 1,
  "concurrency": 2,
  "timeoutMs": 300000,
  "objective": {
    "kind": "outcome",
    "target": "run.output",
    "metrics": [
      "intent_resolution",
      "clarification_precision",
      "effective_intervention",
      "over_action",
      "counterfactual_lift",
      "token_efficiency",
      "tool_efficiency",
      "agentic_cost_score"
    ],
    "metadata": {
      "retrofitCausalDecisions": true
    }
  },
  "configs": [
    {
      "id": "causal-mainline",
      "label": "Causal Policy Router (新因果主链路)",
      "runConfig": {
        "pattern": "orchestrator_subagent",
        "modeSelection": "auto",
        "metadata": {
          "evaluationBatch": "causal-ab-comparison"
        }
      }
    }
  ],
  "metadata": {
    "retrofitCausalDecisions": true,
    "description": "A/B comparison spec for causal policy router vs legacy baseline. Run this spec on both the current commit (causal mainline) and the legacy commit (before causal-policy-router.ts was introduced), then use 'ora-runtime eval compare' to generate the comparison report."
  }
}
