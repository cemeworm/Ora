{
  "datasetId": "dataset-0004",
  "profileId": "orchestration",
  "repetitions": 1,
  "concurrency": 1,
  "timeoutMs": 120000,
  "objective": {
    "kind": "outcome",
    "target": "run.output",
    "metrics": [
      "task_success_rate",
      "llm_judge_score",
      "intent_resolution",
      "clarification_precision",
      "effective_intervention",
      "over_action",
      "counterfactual_lift",
      "token_efficiency",
      "tool_efficiency",
      "agentic_cost_score",
      "visible_surface_shrinkage",
      "explore_first_score",
      "atomic_tool_hops",
      "first_locate_success",
      "shell_explore_restraint"
    ],
    "metadata": {
      "retrofitCausalDecisions": true
    }
  },
  "configs": [
    {
      "id": "stage2-router-v2-only",
      "label": "Router V2 Only",
      "runConfig": {
        "pattern": "orchestrator_subagent",
        "modeSelection": "auto",
        "providerId": "deepseek",
        "modelRef": "deepseek-v4-flash",
        "causalInterventionLevel": "record_only",
        "metadata": {
          "evaluationBatch": "causal-stage2-boundary-smoke",
          "causalRouterVersion": "v2"
        }
      }
    },
    {
      "id": "stage2-router-v2-plus-freshness",
      "label": "Router V2 + Freshness Boundary",
      "runConfig": {
        "pattern": "orchestrator_subagent",
        "modeSelection": "auto",
        "providerId": "deepseek",
        "modelRef": "deepseek-v4-flash",
        "causalInterventionLevel": "record_only",
        "metadata": {
          "evaluationBatch": "causal-stage2-boundary-smoke",
          "causalRouterVersion": "v2",
          "causalFreshnessBlockPolicy": true
        }
      }
    },
    {
      "id": "stage2-router-v2-plus-both-boundaries",
      "label": "Router V2 + Both Boundaries",
      "runConfig": {
        "pattern": "orchestrator_subagent",
        "modeSelection": "auto",
        "providerId": "deepseek",
        "modelRef": "deepseek-v4-flash",
        "causalInterventionLevel": "record_only",
        "metadata": {
          "evaluationBatch": "causal-stage2-boundary-smoke",
          "causalRouterVersion": "v2",
          "causalFreshnessBlockPolicy": true,
          "causalContextProbePolicy": true
        }
      }
    }
  ],
  "metadata": {
    "retrofitCausalDecisions": true,
    "description": "Stage 2 smoke comparison that isolates boundary cost and outcome lift while keeping intervention level fixed at record_only.",
    "evaluationFamily": "causal",
    "judgeRubricTemplate": "causal_outcome_v1",
    "judgePassThreshold": 0.7,
    "rolloutStage": "stage2-boundary-isolation"
  }
}
