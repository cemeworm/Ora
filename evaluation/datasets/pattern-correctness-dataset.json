{
  "description": "验证 5 种协调模式的拓扑行为是否正确。通过 trace.events 检查模式节点状态机转换。",
  "cases": [
    {
      "id": "os-001",
      "prompt": "帮我研究一下 Kubernetes 和 Docker Swarm 的优缺点对比，然后写一份详细的分析报告",
      "expected": {
        "structured": {
          "assertions": [
            { "type": "exists", "path": "trace.events[?(@.type=='agent.started' && @.agentRole=='orchestrator')]", "rationale": "编排器代理应该启动" },
            { "type": "exists", "path": "trace.events[?(@.type=='agent.started' && @.agentRole=='researcher')]", "rationale": "研究子代理应该被委派" },
            { "type": "min", "path": "trace.events[?(@.type=='tool.called')].length", "value": 1, "rationale": "至少有一次工具调用" }
          ]
        }
      },
      "metadata": { "pattern": "orchestrator_subagent", "category": "task_decomposition", "difficulty": "medium" }
    },
    {
      "id": "os-002",
      "prompt": "分析这份用户反馈数据，找出 top 5 关键问题，然后给出改进建议",
      "expected": {
        "structured": {
          "assertions": [
            { "type": "exists", "path": "trace.events[?(@.type=='agent.started' && @.agentRole=='orchestrator')]" },
            { "type": "exists", "path": "trace.events[?(@.type=='agent.started' && @.agentRole=='reviewer')]", "rationale": "审查子代理应该启动" }
          ]
        }
      },
      "metadata": { "pattern": "orchestrator_subagent", "category": "data_analysis", "difficulty": "medium" }
    },
    {
    "id": "os-003",
      "prompt": "设计一个用户认证系统的架构方案，包括数据库设计、API 接口和前端流程",
      "expected": {
        "structured": {
          "assertions": [
            { "type": "exists", "path": "trace.events[?(@.type=='agent.started')]" },
            { "type": "exists", "path": "trace.events[?(@.type=='run.completed' || @.type=='node.completed')]" }
          ]
        }
      },
      "metadata": { "pattern": "orchestrator_subagent", "category": "system_design", "difficulty": "hard" }
    },
