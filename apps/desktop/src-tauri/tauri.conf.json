{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ora",
  "version": "0.3.1",
  "identifier": "dev.ora.workbench",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm run build:bundle",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ora",
        "width": 1440,
        "height": 920,
        "minWidth": 1180,
        "minHeight": 760,
        "resizable": true,
        "fullscreen": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [],
    "resources": {
      "resources/runtime-sidecar/": "runtime-sidecar/",
      "resources/langfuse/": "langfuse/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI0OEFEN0Q2RTcxMjBCOEMKUldTTUN4TG4xdGVLSkVkbWNmUnNvbjUrdzJqZFFiZndYbkFBWFdlWlExV0xNbENsVWR2V29GNHYK",
      "endpoints": [
        "https://github.com/cemeworm/Ora/releases/latest/download/latest.json"
      ]
    }
  }
}
