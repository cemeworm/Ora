    "@tauri-apps/plugin-dialog": "2.7.0",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-updater": "2.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "reactflow": "11.11.4",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
