{
  "name": "@ora/runtime",
  "version": "0.3.9",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "pnpm --filter @cemeworm/shared build && tsc -p tsconfig.build.json",
    "package:sidecar": "pnpm --filter @cemeworm/shared build && node scripts/package-sidecar.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "start": "tsx src/sidecar-entry.ts",
    "smoke": "tsx src/cli.ts --smoke",
    "test": "vitest run"
  },
  "dependencies": {
    "@cemeworm/shared": "workspace:*",
    "@langfuse/core": "^5.3.0",
    "@langfuse/otel": "^5.3.0",
    "@langfuse/tracing": "^5.3.0",
    "@opentelemetry/sdk-node": "^0.215.0",
    "better-sqlite3": "^12.10.0",
    "ioredis": "^5.5.0",
    "pdf-parse": "^2.4.5",
    "undici": "8.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "tsx": "^4.22.0",
    "vitest": "^4.1.7"
  },
  "optionalDependencies": {
    "peekaboo": "^1.0.0"
  }
}
